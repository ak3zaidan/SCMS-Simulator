# --- Rust -------------------------------------------------------------------
/target
**/target
*.profraw

# --- Generated worlds and datasets (large, reproducible from seed + config) ---
/worlds/cache/*
!/worlds/cache/.gitkeep
!/worlds/cache/README.md
/datasets/
*.mcap

# --- Importer and run outputs written to the working directory -----------------
# `import_osm` and the CLI default their output directory to ".", so a bare
# invocation from the repository root drops these here. They are large and fully
# reproducible from the extract plus the options, so they are never committed.
/world.json
/world.v2xw
/world.vwb
/report.txt
/out/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
/python/**/dist/
/python/**/*.so

# --- Node / UI --------------------------------------------------------------
node_modules/
/ui/**/dist/
.vite/

# --- Editors / OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
tmp/

# --- Third-party ASN.1 that may not be redistributed (build decision D3) ------
# The SAE J2735 modules carry an embedded SAE user-licence agreement forbidding
# redistribution ("prohibits the end user from posting or distributing content via
# any public forum"). They may be kept locally for research and read by the build as
# a reference for the hand-written BSM codec, but they are never committed. The ETSI
# forge modules are BSD-3-Clause and ARE committed, under third_party/asn1/etsi/.
/third_party/asn1/j2735/
/third_party/sae/

# --- Legacy reference (frozen, ADR 0002) ------------------------------------
legacy/gui/last_run.log

# --- Secrets — never commit API keys ----------------------------------------
.env
.env.*
