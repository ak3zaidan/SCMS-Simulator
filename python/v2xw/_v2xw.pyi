class plugins:
    """Views, cards and the family adapters."""

    PROBABILITY_QUANTUM: float

    class Ego:
        actor: int
        vehicle_class: str
        lane: int
        lane_index: int
        s_m: float
        lateral_m: float
        speed_mps: float
        accel_mps2: float
        heading_rad: float
        length_m: float
        width_m: float
        height_m: float
        desired_speed_mps: float
        max_accel_mps2: float
        comfort_decel_mps2: float
        time_headway_s: float
        min_gap_m: float

    class Leader:
        gap_m: float
        speed_mps: float
        accel_mps2: float
        length_m: float
        is_vehicle: bool

    class Lane:
        id: int
        kind: str
        speed_limit_mps: float
        width_m: float
        length_m: float

    class Weather:
        kind: str
        intensity: float
        visibility_m: float
        surface: str

    class DetectorCtx:
        t_ns: int
        node: int

    class Observation:
        subject: int
        kind: str
        confidence: float
        t_ns: int
        def __init__(
            self, subject: int, kind: str, confidence: float, t_ns: int
        ) -> None: ...

    class CarFollowingModel:
        def __init__(self, object: Any) -> None: ...
        @property
        def id(self) -> str: ...
        @property
        def card(self) -> Dict[str, Any]: ...
        @property
        def last_error(self) -> Optional[str]: ...
        def accel(
            self,
            ego_speed_mps: float,
            gap_m: Optional[float] = ...,
            leader_speed_mps: float = ...,
            speed_limit_mps: float = ...,
            is_vehicle: bool = ...,
        ) -> float: ...

    class DetectorModel:
        def __init__(self, object: Any) -> None: ...
        @property
        def id(self) -> str: ...
        @property
        def card(self) -> Dict[str, Any]: ...
        @property
        def last_error(self) -> Optional[str]: ...
        def on_messages(
            self, t_ns: int, node: int, batch: Any
        ) -> List["plugins.Observation"]: ...

    class ReferenceDetector:
        def __init__(self, max_speed_mps: float = ...) -> None: ...
        @property
        def card(self) -> Dict[str, Any]: ...
        def on_messages(
            self, t_ns: int, node: int, batch: Any
        ) -> List["plugins.Observation"]: ...

    @staticmethod
    def validate_card(card: Any) -> Dict[str, Any]: ...
    @staticmethod
    def uncited_parameters(card: Any) -> List[str]: ...

