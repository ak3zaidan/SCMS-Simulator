"""Typed stubs for the native module (03-interfaces.md §15: the SDK ships typed stubs).

Hand-written, because the native module is built by a macro and there is no generator that
would produce these from the Rust signatures. That makes them a second description of the
same surface and therefore a thing that can drift; `python/tests/test_stubs.py` checks that
every name here exists on the module and that no public name on the module is missing here,
which catches the drift that matters.
"""

from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple

__version__: str

class V2xwError(Exception): ...
class ScenarioError(V2xwError): ...
class RecordingError(V2xwError): ...
class MetricError(V2xwError): ...
class DeterminismError(V2xwError): ...

