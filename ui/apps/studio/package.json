{
  "name": "@vwp/studio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "V2X World Simulator Studio: the React shell around @vwp/viewer and @vwp/protocol (09-ui \u00a76)",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run && playwright test",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@vwp/protocol": "workspace:*",
    "@vwp/viewer": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vwp/mock-server": "workspace:*",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.5"
  }
}
